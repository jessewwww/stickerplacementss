* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  font-family: Arial, sans-serif;
}

body {
  overflow: hidden;
}

#map {
  width: 100%;
  height: 100vh;
}


/* HEADER */

header {
  position: absolute;

  z-index: 1000;

  top: 15px;
  left: 15px;
  right: 15px;

  display: flex;

  justify-content: space-between;
  align-items: center;

  padding: 15px 20px;

  background: white;

  border-radius: 16px;

  box-shadow:
    0 5px 25px rgba(0,0,0,.2);
}

header h1 {
  margin: 0;

  font-size: 21px;
}

.counter {
  text-align: center;
}

.counter span {
  display: block;

  font-size: 24px;

  font-weight: bold;
}


/* TOOLBAR */

.toolbar {
  position: absolute;

  z-index: 1000;

  top: 95px;
  left: 15px;

  display: flex;

  gap: 8px;

  flex-wrap: wrap;
}

.toolbar input {
  width: 220px;

  padding: 12px;

  border: 0;

  border-radius: 10px;

  box-shadow:
    0 3px 15px rgba(0,0,0,.2);

  outline: none;
}

.toolbar button {
  padding: 12px 15px;

  border: 0;

  border-radius: 10px;

  background: #111;

  color: white;

  font-weight: bold;

  cursor: pointer;

  box-shadow:
    0 3px 15px rgba(0,0,0,.2);
}


/* CENTER */

.center-marker {
  position: fixed;

  z-index: 900;

  top: 50%;
  left: 50%;

  transform:
    translate(-50%, -50%);

  font-size: 45px;

  pointer-events: none;
}


/* PLACE BAR */

.place-bar {
  position: fixed;

  z-index: 1500;

  bottom: 25px;

  left: 50%;

  transform:
    translateX(-50%);

  display: flex;

  gap: 10px;

  padding: 10px;

  background: white;

  border-radius: 15px;

  box-shadow:
    0 5px 25px rgba(0,0,0,.3);
}

.place-bar button {
  padding: 13px 18px;

  border: 0;

  border-radius: 10px;

  cursor: pointer;

  font-weight: bold;
}


/* MODAL */

.modal-background {
  position: fixed;

  z-index: 2000;

  inset: 0;

  background:
    rgba(0,0,0,.55);
}

.modal {
  position: fixed;

  z-index: 2100;

  inset: 0;

  display: flex;

  justify-content: center;

  align-items: center;

  padding: 20px;
}

.modal-box {
  position: relative;

  width: min(420px, 100%);

  padding: 30px;

  background: white;

  border-radius: 20px;

  box-shadow:
    0 20px 60px rgba(0,0,0,.3);
}

.close {
  position: absolute;

  top: 10px;
  right: 12px;

  border: 0;

  background: #eee;

  border-radius: 50%;

  width: 35px;
  height: 35px;

  font-size: 22px;

  cursor: pointer;
}

#selectedLocation {
  color: #666;

  font-size: 13px;
}

textarea {
  width: 100%;

  min-height: 120px;

  resize: none;

  padding: 12px;

  border: 2px solid #ddd;

  border-radius: 12px;

  font-family: inherit;

  font-size: 15px;

  outline: none;
}

.publish {
  width: 100%;

  margin-top: 15px;

  padding: 14px;

  border: 0;

  border-radius: 12px;

  background: #111;

  color: white;

  font-weight: bold;

  cursor: pointer;
}


/* MAP STICKER */

.map-sticker {
  min-width: 55px;

  max-width: 130px;

  min-height: 55px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 8px;

  background: #ffe500;

  border: 3px solid #111;

  border-radius: 50%;

  color: #111;

  font-size: 12px;

  font-weight: bold;

  text-align: center;

  box-shadow:
    3px 4px 0 #111;

  cursor: pointer;

  transform: rotate(-4deg);
}


/* MOBILE */

@media (max-width: 600px) {

  header {
    top: 8px;
    left: 8px;
    right: 8px;
  }

  header h1 {
    font-size: 17px;
  }

  .toolbar {
    top: 85px;
    left: 8px;
    right: 8px;
  }

  .toolbar input {
    width: 100%;
  }

  .toolbar button {
    flex: 1;
  }

  .place-bar {
    width: calc(100% - 20px);
  }

  .place-bar button {
    flex: 1;
  }

}
