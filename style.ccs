* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  font-family: Arial, Helvetica, sans-serif;
  background: #f5f5f5;
}

body {
  overflow: hidden;
}

.app {
  width: 100%;
  height: 100vh;
  position: relative;
}


/* HEADER */

.topbar {
  position: absolute;
  z-index: 1000;
  top: 15px;
  left: 15px;
  right: 15px;

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 14px 18px;

  background: rgba(255,255,255,.96);
  border-radius: 18px;

  box-shadow: 0 5px 25px rgba(0,0,0,.15);
}

.topbar h1 {
  margin: 0;
  font-size: 21px;
}

.topbar p {
  margin: 4px 0 0;
  color: #777;
  font-size: 13px;
}

.counter {
  display: flex;
  flex-direction: column;
  align-items: center;

  min-width: 65px;

  color: #555;
  font-size: 11px;
}

.counter strong {
  font-size: 21px;
  color: #111;
}


/* SEARCH */

.search {
  position: absolute;
  z-index: 1000;

  top: 100px;
  left: 15px;

  display: flex;

  width: min(400px, calc(100% - 30px));

  background: white;

  border-radius: 13px;

  box-shadow: 0 4px 18px rgba(0,0,0,.15);

  overflow: hidden;
}

.search input {
  flex: 1;

  border: 0;
  outline: 0;

  padding: 13px 15px;

  font-size: 15px;
}

.search button {
  width: 50px;

  border: 0;

  background: #111;
  color: white;

  cursor: pointer;

  font-size: 17px;
}

.search button:hover {
  background: #333;
}


/* MAP */

#map {
  width: 100%;
  height: 100%;
}


/* PLACE BUTTON */

.placeButton {
  position: absolute;
  z-index: 1000;

  bottom: 25px;
  left: 50%;

  transform: translateX(-50%);

  border: 0;

  padding: 15px 24px;

  border-radius: 50px;

  background: #111;
  color: white;

  font-size: 15px;
  font-weight: bold;

  box-shadow: 0 6px 25px rgba(0,0,0,.3);

  cursor: pointer;
}

.placeButton:hover {
  transform: translateX(-50%) scale(1.03);
}


/* CENTER MARKER */

.centerMarker {
  position: absolute;

  z-index: 900;

  top: 50%;
  left: 50%;

  transform: translate(-50%, -100%);

  pointer-events: none;
}

.centerMarker div {
  width: 55px;
  height: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: white;

  border-radius: 50%;

  box-shadow:
    0 4px 20px rgba(0,0,0,.3);

  font-size: 27px;
}


/* PLACE BAR */

.placeBar {
  position: absolute;

  z-index: 1100;

  bottom: 20px;
  left: 50%;

  transform: translateX(-50%);

  display: flex;
  gap: 10px;

  background: white;

  padding: 10px;

  border-radius: 16px;

  box-shadow: 0 5px 25px rgba(0,0,0,.25);
}

.placeBar button {
  border: 0;

  padding: 12px 18px;

  border-radius: 10px;

  cursor: pointer;

  font-weight: bold;
}

.cancel {
  background: #eee;
  color: #333;
}

.confirm {
  background: #111;
  color: white;
}


/* MODAL */

.modalBackground {
  position: fixed;

  z-index: 2000;

  inset: 0;

  background: rgba(0,0,0,.55);

  backdrop-filter: blur(4px);
}

.modal {
  position: fixed;

  z-index: 2100;

  inset: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 20px;
}

.modalBox {
  position: relative;

  width: min(430px, 100%);

  background: white;

  padding: 30px;

  border-radius: 24px;

  box-shadow: 0 20px 60px rgba(0,0,0,.3);

  text-align: center;
}

.close {
  position: absolute;

  top: 12px;
  right: 15px;

  width: 35px;
  height: 35px;

  border: 0;

  border-radius: 50%;

  background: #eee;

  font-size: 24px;

  cursor: pointer;
}

.modalIcon {
  font-size: 45px;
}

.modalBox h2 {
  margin: 10px 0 5px;
}

.modalBox p {
  margin: 0 0 20px;

  color: #777;
}

textarea {
  width: 100%;

  min-height: 120px;

  resize: vertical;

  border: 2px solid #eee;

  border-radius: 14px;

  padding: 14px;

  font-family: inherit;

  font-size: 15px;

  outline: none;
}

textarea:focus {
  border-color: #111;
}

.characterCount {
  text-align: right;

  margin-top: 5px;

  color: #999;

  font-size: 11px;
}

.publish {
  width: 100%;

  margin-top: 18px;

  padding: 14px;

  border: 0;

  border-radius: 12px;

  background: #111;

  color: white;

  font-size: 15px;

  font-weight: bold;

  cursor: pointer;
}


/* SAVE OVERLAY */

.saveOverlay {
  position: fixed;

  z-index: 3000;

  inset: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  background: rgba(0,0,0,.65);

  backdrop-filter: blur(5px);
}

.saveBox {
  width: min(350px, calc(100% - 40px));

  padding: 35px;

  border-radius: 25px;

  background: white;

  text-align: center;
}

.saveBox h2 {
  margin: 15px 0 5px;
}

.saveBox p {
  color: #777;
}


/* LOADING */

.loading {
  width: 55px;
  height: 55px;

  margin: auto;

  border: 5px solid #eee;

  border-top-color: #111;

  border-radius: 50%;

  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}


/* SUCCESS */

.success {
  width: 60px;
  height: 60px;

  margin: auto;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #22c55e;

  color: white;

  font-size: 35px;
  font-weight: bold;
}


/* NOTIFICATION */

.notification {
  position: fixed;

  z-index: 4000;

  bottom: 90px;
  left: 50%;

  transform: translateX(-50%);

  padding: 13px 20px;

  background: #111;
  color: white;

  border-radius: 50px;

  box-shadow: 0 5px 20px rgba(0,0,0,.3);

  font-weight: bold;
}


/* STICKERS */

.sticker {
  min-width: 62px;
  max-width: 130px;

  min-height: 62px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 8px;

  background: #ffe600;

  color: #111;

  border: 3px solid #111;

  border-radius: 50%;

  box-shadow: 3px 4px 0 #111;

  font-size: 12px;

  font-weight: bold;

  text-align: center;

  overflow-wrap: anywhere;

  transform: rotate(-4deg);
}


/* POPUP */

.leaflet-popup-content {
  margin: 14px;
}

.leaflet-popup-content h3 {
  margin-top: 0;
}

.delete {
  border: 0;

  padding: 9px 13px;

  border-radius: 9px;

  background: #ef4444;

  color: white;

  cursor: pointer;

  font-weight: bold;
}


/* MOBILE */

@media (max-width: 600px) {

  .topbar {
    top: 10px;
    left: 10px;
    right: 10px;
  }

  .topbar h1 {
    font-size: 17px;
  }

  .search {
    top: 85px;
    left: 10px;

    width: calc(100% - 20px);
  }

  .placeBar {
    width: calc(100% - 20px);

    justify-content: center;
  }

  .placeBar button {
    flex: 1;

    padding: 12px 8px;
  }

  .modalBox {
    padding: 25px 20px;
  }

}
