body{
margin:0;
font-family:Arial;
}


header{

position:absolute;
z-index:1000;

top:10px;
left:10px;
right:10px;

background:white;

padding:15px;

border-radius:15px;

box-shadow:0 3px 15px #0003;

display:flex;

justify-content:space-between;

}


#map{

height:100vh;
width:100%;

}



.search{

position:absolute;

z-index:1000;

top:80px;
left:10px;

}


.search input{

padding:10px;

}


button{

padding:10px;

border:0;

border-radius:10px;

cursor:pointer;

}



#placeBtn{

position:absolute;

z-index:1000;

bottom:20px;

left:50%;

transform:translateX(-50%);

background:#111;

color:white;

}



#marker{

display:none;

position:absolute;

z-index:900;

top:50%;

left:50%;

transform:translate(-50%,-100%);

font-size:45px;

}



#confirmBox{

display:none;

position:absolute;

z-index:1200;

bottom:80px;

left:50%;

transform:translateX(-50%);

background:white;

padding:15px;

gap:10px;

border-radius:15px;

}



#popup{

display:none;

position:absolute;

z-index:2000;

top:50%;

left:50%;

transform:translate(-50%,-50%);

background:white;

padding:25px;

border-radius:20px;

}



textarea{

width:250px;

height:100px;

}



.sticker{

background:#ffe600;

border:3px solid black;

border-radius:50%;

width:60px;

height:60px;

display:flex;

align-items:center;

justify-content:center;

text-align:center;

font-size:12px;

font-weight:bold;

box-shadow:3px 3px 0 black;

}
